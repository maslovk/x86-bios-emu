#!/usr/bin/env python3
"""Build Volkov Commander with the real Borland tools in the emulator.

The build is deliberately transactional. TASM, the Volkov sources, and the
link tools are copied to a temporary DOS workspace; DPMIINST configures that
copy of DPMI16BI.OVL, and only complete VC.COM/VC.OVL files are published to
build/volkov.
"""

import argparse
import os
from pathlib import Path
import re
import shutil
import sys
import tempfile


SCRIPT_DIR = Path(__file__).resolve().parent
REPO_DIR = SCRIPT_DIR.parent
sys.path.insert(0, str(REPO_DIR))

from dosharness import DOSHarness  # noqa: E402


class BuildError(RuntimeError):
    """A guest command or build prerequisite failed."""


def nonblank_lines(screen):
    return [line.rstrip() for line in screen.splitlines() if line.strip()]


def at_prompt(screen, drive):
    """Return true for a bottom-row ``E:\\>``-style DOS prompt."""
    lines = nonblank_lines(screen)
    if not lines:
        return False
    return re.search(rf'{re.escape(drive)}:\\[^>]*>$', lines[-1]) is not None


def screen_tail(screen, count=14):
    return '\n'.join(nonblank_lines(screen)[-count:])


class GuestDriver:
    """Prompt-aware driver for host-mounted DOS drives D: through F:."""

    def __init__(self, harness):
        self.harness = harness
        self.harness.cpu.max_insns = max(
            self.harness.cpu.max_insns,
            self.harness.cpu.insn_count + 1_500_000_000)

    def wait(self, predicate, budget, description):
        spent = 0
        progress = os.environ.get('VC_BUILD_PROGRESS') == '1'
        trace = ((os.environ.get('VC_BUILD_TRACE') == '1' or progress) and
                 ('TASMX' in description or progress))
        next_trace = (1_000_000 if progress
                      else 5_000_000)
        while spent < budget:
            screen = self.harness.vga_str()
            if any(message in screen.lower() for message in (
                    'unhandled exception', 'internal stack overflow', 'system halted')):
                raise BuildError(f'guest terminated while waiting for {description}:\n'
                                 + screen_tail(screen))
            if predicate(screen):
                print(f'  reached {description} ({spent:,} steps)', flush=True)
                return screen
            batch = min(250_000, budget - spent)
            self.harness.run_steps(batch)
            spent += batch
            if trace and spent >= next_trace:
                cpu = self.harness.cpu
                code_addr = cpu._code_base + cpu.ip
                code = bytes(cpu._readb(code_addr + i) for i in range(8))
                print(f'  [trace] {description}: {spent:,} steps '
                      f'CS:IP={cpu.cs:04X}:{cpu.ip:04X} '
                      f'SS:SP={cpu.ss:04X}:{cpu.sp:04X} '
                      f'AX={cpu.ax:04X} BX={cpu.bx:04X} '
                      f'CX={cpu.cx:04X} DX={cpu.dx:04X} '
                      f'bytes={code.hex()} '
                      f'pm={cpu._pm} halted={cpu.halted} '
                      f'resets={getattr(self.harness.emu, "reset_requests", [])}\n'
                      f'{screen_tail(self.harness.vga_str(), 4)}', flush=True)
                next_trace += (1_000_000 if progress else 5_000_000)
        cpu = self.harness.cpu
        code_addr = cpu._code_base + cpu.ip
        code = bytes(cpu._readb(code_addr + i) for i in range(8))
        raise BuildError(
            f'timed out waiting for {description} at '
            f'{cpu.cs:04X}:{cpu.ip:04X} '
            f'op={code.hex()} pm={cpu._pm} '
            f'SS:SP={cpu.ss:04X}:{cpu.sp:04X} '
            f'AX={cpu.ax:04X} BX={cpu.bx:04X} '
            f'CX={cpu.cx:04X} DX={cpu.dx:04X} '
            f'resets={getattr(self.harness.emu, "reset_requests", [])}\n'
            f'{screen_tail(self.harness.vga_str())}')

    def change_drive(self, drive):
        previous = self.harness.vga_str()
        self.harness.inject_string(f'{drive}:\r')
        return self.wait(
            lambda screen: screen != previous and at_prompt(screen, drive),
            5_000_000, f'{drive}: prompt')

    def command(self, command, drive, budget):
        """Run one command, require its prompt and ERRORLEVEL zero."""
        scroll_start = len(self.harness._scrollback)
        previous = self.harness.vga_str()
        print(f'  {drive}:\\> {command}', flush=True)
        self.harness.inject_string(command + '\r')
        screen = self.wait(
            lambda current: current != previous and at_prompt(current, drive),
            budget, f'completion of {command.split()[0]}')
        output = self.harness._transcript(scroll_start)

        marker = '__VC_BUILD_FAILED__'
        marker_start = len(self.harness._scrollback)
        previous = screen
        self.harness.inject_string(f'IF ERRORLEVEL 1 ECHO {marker}\r')
        self.wait(
            lambda current: current != previous and at_prompt(current, drive),
            5_000_000, 'ERRORLEVEL probe')
        probe = self.harness._transcript(marker_start)
        if marker in {line.strip() for line in probe.splitlines()}:
            raise BuildError(
                f'guest command failed: {command}\n{screen_tail(output, 24)}')
        return output

    def tasmx_command(self, command, drive, budget):
        """Configured TASMX runs normally and must return ERRORLEVEL zero."""
        return self.command(command, drive, budget)

    def configure_dpmi(self):
        print('Configuring the Borland 16-bit DPMI host...', flush=True)
        self.harness.inject_string('DPMIINST.EXE\r')
        # A supplied DPMI16BI.OVL may already contain the machine database
        # entry.  In that case DPMIINST returns directly to DOS and there is
        # no Proceed/A20 prompt to answer.
        initial = self.wait(
            lambda screen: ('proceed? (space to continue' in screen.lower()
                            or 'machine already in dpmi16bi' in screen.lower()
                            or at_prompt(screen, 'D')),
            60_000_000, 'DPMIINST startup')
        if ('machine already in dpmi16bi' in initial.lower() or
                at_prompt(initial, 'D')):
            print('  DPMI16BI.OVL already configured.', flush=True)
            return
        prompts = (
            ('Proceed? (space to continue', 60_000_000, 'Proceed prompt'),
            ('A20 enabled, please press', 30_000_000, 'A20-enabled prompt'),
            ('A20 disabled now, please press', 30_000_000,
             'A20-disabled prompt'),
            ('Back in real mode, please press', 40_000_000,
             'real-mode-return prompt'),
        )
        for text, budget, description in prompts:
            self.wait(lambda screen, text=text: text in screen,
                      budget, description)
            self.harness.inject_string(' ')

        # Later safety/timing passes are mostly silent, but periodically
        # perform a keyboard-liveness check. A fresh space after each bounded
        # interval handles both ordinary and "hold space" variants.
        failure_text = (
            'unable to make a conclusive analysis',
            'file allocation table bad',
            'cannot find method',
            'error writing checkpoint file',
        )
        comment_sent = False
        for phase in range(1, 21):
            for _ in range(40):
                self.harness.run_steps(250_000)
                screen = self.harness.vga_str()
                lowered = screen.lower()
                if any(text in lowered for text in failure_text):
                    raise BuildError(
                        'DPMIINST could not configure the host:\n'
                        + screen_tail(screen, 24))
                if at_prompt(screen, 'D'):
                    if 'DPMI16BI file' not in screen or 'updated' not in screen:
                        raise BuildError(
                            'DPMIINST returned without updating DPMI16BI.OVL:\n'
                            + screen_tail(screen, 24))
                    print(f'  DPMI16BI.OVL configured (phase {phase})',
                          flush=True)
                    return
                if ('please enter comment for database file' in lowered
                        and not comment_sent):
                    self.harness.inject_string('\r')
                    comment_sent = True
                    continue
                # The installer can ask for another liveness key within
                # this phase. Keep one key available without building up a
                # typeahead backlog or waiting ten million instructions.
                controller = self.harness.emu.kbd_ctrl
                if controller is not None and not controller.has_data():
                    self.harness.inject_string(' ')
            self.harness.inject_string(' ')
            print(f'  completed DPMI safety phase {phase}', flush=True)
        raise BuildError(
            'DPMIINST did not return to DOS:\n'
            + screen_tail(self.harness.vga_str(), 24))


def copy_workspace(source, destination):
    shutil.copytree(source, destination)


def copy_tool_files(source, destination):
    """Stage top-level DOS tools without copying archival source folders."""
    destination.mkdir(parents=True, exist_ok=True)
    for path in source.iterdir():
        if path.is_file():
            shutil.copy2(path, destination / path.name)


def remove_stale_outputs(source_dir):
    for name in ('VC.COM', 'VC.EXE', 'VC.OBJ', 'VC.OVL', 'VCOVL.OBJ'):
        path = source_dir / name
        if path.exists():
            path.unlink()


def publish_atomic(source, destination):
    destination.parent.mkdir(parents=True, exist_ok=True)
    fd, temporary = tempfile.mkstemp(
        prefix=f'.{destination.name}.', suffix='.tmp', dir=destination.parent)
    os.close(fd)
    temporary_path = Path(temporary)
    try:
        shutil.copy2(source, temporary_path)
        os.replace(temporary_path, destination)
    finally:
        temporary_path.unlink(missing_ok=True)


def resolve_path(value, default):
    return Path(value).expanduser().resolve() if value else default.resolve()


def parse_args(argv=None):
    parser = argparse.ArgumentParser(
        description='Build VC.COM and VC.OVL inside the Python x86 emulator.')
    parser.add_argument(
        'hard_disk', nargs='?',
        default=os.environ.get('VC_HARD_DISK', REPO_DIR / 'dos622-new.hdd'),
        help='bootable DOS 6.22 hard-disk image (default: dos622-new.hdd)')
    parser.add_argument(
        '--output-dir',
        default=os.environ.get('VC_OUTPUT_DIR', REPO_DIR / 'build/volkov'),
        help='artifact directory (default: build/volkov)')
    parser.add_argument(
        '--tasm-dir', default=os.environ.get('VC_TASM_DIR'),
        help='Borland TASM/DPMI tool directory')
    parser.add_argument(
        '--tasmx', default=os.environ.get('VC_TASMX'),
        help='protected-mode TASMX.EXE (default: TASM directory/TASMX.EXE)')
    parser.add_argument(
        '--source-dir', default=os.environ.get('VC_SOURCE_DIR'),
        help='Volkov Commander source directory')
    parser.add_argument(
        '--link-dir', default=os.environ.get('VC_LINK_DIR'),
        help='directory containing LINK.EXE and EXE2BIN.EXE')
    parser.add_argument(
        '--tasmx-only', action='store_true',
        help='skip the VC.COM loader and run only the TASMX overlay build')
    parser.add_argument(
        '--skip-dpmi-config', action='store_true',
        help='use a preconfigured DPMI16BI.OVL instead of running DPMIINST')
    return parser.parse_args(argv)


def build(args):
    hard_disk = Path(args.hard_disk).expanduser().resolve()
    output_dir = Path(args.output_dir).expanduser().resolve()
    tasm_source = resolve_path(
        args.tasm_dir, REPO_DIR / 'DOS_sources/TASM')
    tasmx_source = resolve_path(
        args.tasmx, tasm_source / 'TASMX.EXE')
    vc_source = resolve_path(
        args.source_dir, REPO_DIR / 'DOS_sources/VC_source')
    link_source = resolve_path(
        args.link_dir, REPO_DIR / 'DOS_sources/v4.0/src/TOOLS')
    dos_disk = REPO_DIR / 'DOS6_22/Disk1.img'

    required = (
        hard_disk, dos_disk, tasm_source / 'DPMIINST.EXE',
        tasm_source / 'DPMI16BI.OVL', tasm_source / 'TASM.EXE',
        tasmx_source,
        vc_source / 'VC.ASM', vc_source / 'VCOVL.ASM',
        link_source / 'LINK.EXE', link_source / 'EXE2BIN.EXE',
    )
    missing = [str(path) for path in required if not path.exists()]
    if missing:
        detail = 'missing build input(s):\n  ' + '\n  '.join(missing)
        if str(tasmx_source) in missing:
            detail += (
                '\nVC.OVL cannot be built by the bundled real-mode TASM.EXE '
                '(it runs out of conventional memory). Supply Borland\'s '
                'protected-mode TASMX.EXE with --tasmx PATH or VC_TASMX=PATH.')
        raise BuildError(detail)

    with tempfile.TemporaryDirectory(prefix='volkov-build-') as temporary:
        root = Path(temporary)
        tasm_dir = root / 'tasm'
        source_dir = root / 'source'
        link_dir = root / 'link'
        copy_tool_files(tasm_source, tasm_dir)
        shutil.copy2(tasmx_source, tasm_dir / 'TASMX.EXE')
        # TASMX is a Borland extender and loads its runtime beside the
        # executable.  When TASMX comes from the TASM 4.0 BIN directory but
        # DPMIINST/TASM come from the legacy tool directory, stage the shared
        # runtime companions explicitly.
        for companion in ('RTM.EXE', 'DPMI16BI.OVL', 'DPMI32VM.OVL'):
            candidate = tasmx_source.parent / companion
            if candidate.is_file():
                shutil.copy2(candidate, tasm_dir / companion)
        copy_workspace(vc_source, source_dir)
        link_dir.mkdir()
        shutil.copy2(link_source / 'LINK.EXE', link_dir / 'LINK.EXE')
        shutil.copy2(link_source / 'EXE2BIN.EXE', link_dir / 'EXE2BIN.EXE')
        remove_stale_outputs(source_dir)

        harness = DOSHarness(
            image_path=str(dos_disk), hard_disk=str(hard_disk),
            boot_drive=0x80, writable=True,
            host_mounts={
                'D': str(tasm_dir),
                'E': str(source_dir),
                'F': str(link_dir),
            },
            host_dir_write=True, cpu_backend='python')
        if os.environ.get('VC_BUILD_TRACE') == '1':
            # DPMIINST probes disk paths before its self-test reset.  Keep a
            # bounded record of low-numbered hard-disk writes so a reboot
            # failure can be distinguished from a CPU-state failure.
            disk = harness.emu.hard_disk
            original_write_sector = disk.write_sector
            def trace_disk_write(lba, buf):
                if lba < 64:
                    print(f'  [trace] HDD write lba={lba} '
                          f'head={bytes(buf[:8]).hex()}', flush=True)
                return original_write_sector(lba, buf)
            disk.write_sector = trace_disk_write
            original_reset = harness.emu._warm_reset
            def trace_reset(reason):
                cpu = harness.cpu
                changed = []
                current = harness.emu.mem.ram
                start = None
                for address in range(0xA0000):
                    if current[address] != boot_memory[address]:
                        if start is None:
                            start = address
                    elif start is not None:
                        changed.append((start, address))
                        start = None
                if start is not None:
                    changed.append((start, 0xA0000))
                summary = ' '.join(f'{a:05X}-{b:05X}'
                                   for a, b in changed[:16])
                pages = sorted({address // 0x1000
                                 for address in range(0xA0000)
                                 if current[address] != boot_memory[address]})
                restore_mode = os.environ.get('VC_RESTORE_DOS_LOW')
                if restore_mode:
                    restore_end = 0x20000 if restore_mode == '1' else 0x50000
                    current[:restore_end] = boot_memory[:restore_end]
                    print(f'  [trace] restored pre-TASMX DOS workspace '
                          f'0x00000-0x{restore_end - 1:05X}', flush=True)
                print(f'  [trace] RESET reason={reason} '
                      f'CS:IP={cpu.cs:04X}:{cpu.ip:04X} '
                      f'pm={cpu._pm} '
                      f'shutdown={harness.emu.cmos._data[0x0F]:02X} '
                      f'vector={harness.emu.mem.read_word(0x0469):04X}:'
                      f'{harness.emu.mem.read_word(0x0467):04X} '
                      f'changed={len(changed)} ranges={summary} '
                      f'pages={pages[:32]}', flush=True)
                return original_reset(reason)
            harness.emu._warm_reset = trace_reset
            original_gp = harness.cpu._raise_gp
            def trace_gp(error_code=0):
                import traceback
                cpu = harness.cpu
                compat_addr = cpu.gdt_base + ((cpu.cs >> 3) * 8)
                compat_raw = bytes(cpu._readb((compat_addr + i) & 0xFFFFF)
                                   for i in range(8)).hex()
                print(f'  [trace] GP error={error_code:04X} '
                      f'CS:IP={cpu.cs:04X}:{cpu.ip:04X} '
                      f'DS={cpu.ds:04X} ES={cpu.es:04X} '
                      f'SS={cpu.ss:04X}:{cpu.sp:04X} '
                      f'LDTR={cpu.ldtr_selector:04X} '
                      f'CSdesc={cpu._desc_cache.get(cpu.cs)!r} '
                      f'GDT[{cpu.cs >> 3:04X}]={compat_raw} '
                      f'nearby={bytes(cpu._readb((cpu._code_base + cpu.ip - 16 + i) & 0xFFFFF) for i in range(24)).hex()}',
                      flush=True)
                traceback.print_stack(limit=8)
                return original_gp(error_code)
            harness.cpu._raise_gp = trace_gp
            original_exception = harness.cpu._do_exception
            def trace_exception(number, error_code):
                cpu = harness.cpu
                print(f'  [trace] EXCEPTION {number} error={error_code:04X} '
                      f'at {cpu.cs:04X}:{cpu.ip:04X} cpl={cpu._cpl} '
                      f'active={cpu._exception_active}', flush=True)
                if number == 11:
                    base = cpu._ldt_base()
                    limit = cpu._ldt_limit()
                    index = error_code >> 3
                    addr = base + index * 8
                    raw = bytes(cpu._readb((addr + i) & 0xFFFFF)
                                for i in range(8)) if addr + 7 <= base + limit else b''
                    print(f'  [trace] NP LDT={cpu.ldtr_selector:04X} '
                          f'base={base:06X} limit={limit:04X} '
                          f'sel={error_code:04X} raw={raw.hex()}', flush=True)
                    addr = (cpu._code_base + cpu.ip) & 0xFFFFF
                    nearby = bytes(cpu._readb((addr + i) & 0xFFFFF)
                                   for i in range(10))
                    print(f'  [trace] NP instruction bytes={nearby.hex()} '
                          f'AX={cpu.ax:04X} BX={cpu.bx:04X} '
                          f'CX={cpu.cx:04X} DX={cpu.dx:04X} '
                          f'DS={cpu.ds:04X} ES={cpu.es:04X} '
                          f'SS={cpu.ss:04X}:{cpu.sp:04X}', flush=True)
                    ss_desc = cpu._desc_cache.get(cpu.ss)
                    offset = (cpu.bp + cpu.si) & 0xFFFF
                    ea = ((ss_desc[0] if ss_desc else (cpu.ss << 4))
                          + offset) & 0xFFFFF
                    print(f'  [trace] NP SSdesc={ss_desc!r} '
                          f'BP={cpu.bp:04X} SI={cpu.si:04X} off={offset:04X} '
                          f'LES_EA={ea:06X} ptr={bytes(cpu._readb(ea + i) for i in range(4)).hex()}',
                          flush=True)
                return original_exception(number, error_code)
            harness.cpu._do_exception = trace_exception
            original_interrupt = harness.cpu._do_interrupt
            def trace_interrupt(number, error_code=None, software=False):
                cpu = harness.cpu
                if number == 13 or cpu._pm:
                    gate_addr = cpu.idt_base + number * 8
                    gate = bytes(cpu._readb((gate_addr + i) & 0xFFFFF)
                                 for i in range(8))
                    print(f'  [trace] INT{number:02X} IDT={cpu.idt_base:06X}:'
                          f'{cpu.idt_limit:04X} gate={gate.hex()} '
                          f'error={error_code!r} software={software} '
                          f'cpl={cpu._cpl} AX={cpu.ax:04X} '
                          f'BX={cpu.bx:04X} DX={cpu.dx:04X}', flush=True)
                return original_interrupt(number, error_code, software)
            harness.cpu._do_interrupt = trace_interrupt
            original_dispatch = harness.cpu._dispatch
            trace_window = [0]
            def trace_tables(opcode):
                cpu = harness.cpu
                if trace_window[0]:
                    print(f'  [trace] handoff {cpu.cs:04X}:'
                          f'{(cpu.ip - 1) & 0xFFFF:04X} '
                          f'op={opcode:02X} SP={cpu.sp:04X} '
                          f'flags={cpu.flags:04X}', flush=True)
                    trace_window[0] -= 1
                if opcode in (0xCA, 0xCB) and cpu.cs == 0x116D:
                    stack_addr = cpu._phys(cpu.ss, cpu.sp)
                    frame = bytes(cpu._readb((stack_addr + i) & 0xFFFFF)
                                  for i in range(16)).hex()
                    print(f'  [trace] RETF frame SS:SP={cpu.ss:04X}:'
                          f'{cpu.sp:04X} addr={stack_addr:05X} '
                          f'code32={cpu._code32} op32={cpu._operand_size_32} '
                          f'bytes={frame}', flush=True)
                if opcode == 0x0F:
                    # _dispatch is entered after execute() has fetched the
                    # primary opcode, so CS:IP points one byte past 0F.
                    pos = (cpu._code_base + cpu.ip - 1) & 0xFFFFF
                    opcode2 = cpu._readb((pos + 1) & 0xFFFFF)
                    if opcode2 in (0x00, 0x01):
                        raw = bytes(cpu._readb((pos + i) & 0xFFFFF)
                                    for i in range(12)).hex()
                        print(f'  [trace] 0F{opcode2:02X} at '
                              f'{cpu.cs:04X}:{cpu.ip:04X} '
                              f'code32={cpu._code32} addr32='
                              f'{getattr(cpu, "_address_size_32", False)} '
                              f'bytes={raw}',
                              flush=True)
                        result = original_dispatch(opcode)
                        print(f'  [trace] tables GDT={cpu.gdt_base:08X}:'
                              f'{cpu.gdt_limit:04X} IDT={cpu.idt_base:08X}:'
                              f'{cpu.idt_limit:04X} LDTR={cpu.ldtr_selector:04X}',
                              flush=True)
                        if (opcode2 == 0x01 and cpu.cs == 0x0020 and
                                cpu.idt_base == 0):
                            trace_window[0] = 48
                        return result
                return original_dispatch(opcode)
            harness.cpu._dispatch = trace_tables
            original_set_msw = harness.cpu._set_msw
            def trace_msw(value):
                cpu = harness.cpu
                before = cpu.msw
                result = original_set_msw(value)
                print(f'  [trace] MSW {before:04X}->{cpu.msw:04X} '
                      f'pm={cpu._pm} at {cpu.cs:04X}:{cpu.ip:04X}', flush=True)
                return result
            harness.cpu._set_msw = trace_msw
            original_far_transfer = harness.cpu._far_transfer
            def trace_far_transfer(selector, offset, is_call, offset32=False):
                cpu = harness.cpu
                trace_far = cpu._pm
                if trace_far:
                    print(f'  [trace] FAR {"CALL" if is_call else "JMP"} '
                          f'{cpu.cs:04X}:{cpu.ip:04X} -> '
                          f'{selector:04X}:{offset:08X} '
                          f'pm={cpu._pm} code32={cpu._code32} '
                          f'offset32={offset32} '
                          f'LDTR={cpu.ldtr_selector:04X} '
                          f'oldcache={cpu._desc_cache.get(cpu.cs)!r} '
                          f'targetcache={cpu._desc_cache.get(selector)!r}',
                          flush=True)
                result = original_far_transfer(
                    selector, offset, is_call, offset32=offset32)
                if trace_far:
                    print(f'  [trace] FAR result CS:IP={cpu.cs:04X}:'
                          f'{cpu.ip:08X} base={cpu._code_base:08X} '
                          f'code32={cpu._code32} '
                          f'cache={cpu._desc_cache.get(cpu.cs)!r}',
                          flush=True)
                return result
            harness.cpu._far_transfer = trace_far_transfer
        driver = GuestDriver(harness)

        print('Booting MS-DOS 6.22...', flush=True)
        driver.wait(lambda screen: at_prompt(screen, 'C'),
                    35_000_000, 'DOS C: prompt')
        # Save DOS's native INT 21h entry before DPMI/TASMX replaces the IVT
        # vector with a protected-mode thunk.  Protected-mode DOS calls must
        # re-enter this original handler through the bridge in main.py.
        dos_ip = harness.emu.mem.read_word(0x21 * 4)
        dos_cs = harness.emu.mem.read_word(0x21 * 4 + 2)
        harness.emu._dos_int21_vector = (dos_cs, dos_ip)
        if os.environ.get('VC_BUILD_TRACE') == '1':
            print(f'  [trace] DOS native IVT21={dos_cs:04X}:{dos_ip:04X}',
                  flush=True)
        driver.change_drive('D')
        if args.skip_dpmi_config:
            print('Using the supplied preconfigured DPMI16BI.OVL.', flush=True)
        else:
            driver.command('DPMIINST -f02/02/04/0000/0000', 'D', 10_000_000)

        driver.command(r'PATH D:\;F:\;C:\DOS', 'D', 5_000_000)
        driver.change_drive('E')
        if not args.tasmx_only:
            print('Building the VC.COM loader...', flush=True)
            driver.command('TASM /z/m9/kh10000 VC', 'E', 120_000_000)
            driver.command(r'F:\LINK.EXE VC.OBJ,VC.EXE;', 'E', 60_000_000)
            driver.command(r'F:\EXE2BIN.EXE VC.EXE VC.COM', 'E', 30_000_000)

        print('Building the VC.OVL program overlay...', flush=True)
        if os.environ.get('VC_BUILD_TRACE') == '1':
            # Snapshot after DOS boot/path setup so the reset diff contains
            # only changes made by TASMX/DPMI16BI, not normal initialization.
            boot_memory = bytes(harness.emu.mem.ram[:0xA0000])
            cpu = harness.cpu
            print(f'  [trace] TASMX launch CS:IP={cpu.cs:04X}:{cpu.ip:04X} '
                  f'pm={cpu._pm} GDT={cpu.gdt_base:08X}:{cpu.gdt_limit:04X} '
                  f'IDT={cpu.idt_base:08X}:{cpu.idt_limit:04X} '
                  f'LDTR={cpu.ldtr_selector:04X} TR={cpu.tr_selector:04X}',
                  flush=True)
            ivt_ip = cpu.mem.read_word(0x21 * 4)
            ivt_cs = cpu.mem.read_word(0x21 * 4 + 2)
            ivt_addr = (ivt_cs << 4) + ivt_ip
            ivt_bytes = bytes(cpu.mem.read_byte(ivt_addr + i)
                              for i in range(8))
            print(f'  [trace] IVT21={ivt_cs:04X}:{ivt_ip:04X} '
                  f'bytes={ivt_bytes.hex()}', flush=True)
        tasmx_budget = int(os.environ.get('VC_TASMX_BUDGET',
                                          '600000000'))
        if os.environ.get('VC_CS_TRACE') == '1':
            harness.cpu._vc_cs_trace_count = 0
        tasmx_output = driver.tasmx_command(
            'TASMX /z/m9/kh10000 VCOVL', 'E', tasmx_budget)
        if not args.tasmx_only:
            driver.command(r'F:\LINK.EXE VCOVL.OBJ,VC.OVL;', 'E', 120_000_000)

        # DOSHarness runs in process, so explicitly write dirty D:/E:/F:
        # FAT images back to their temporary host directories.
        harness.emu._persist_host_dir()

        products = ((source_dir / 'VCOVL.OBJ',) if args.tasmx_only else
                    (source_dir / 'VC.COM', source_dir / 'VC.OVL'))
        for product in products:
            if not product.is_file() or product.stat().st_size == 0:
                raise BuildError(
                    f'expected artifact was not produced: {product.name}\n'
                    f'{screen_tail(tasmx_output, 20)}')
        for product in products:
            publish_atomic(product, output_dir / product.name)
            print(f'Published {output_dir / product.name} '
                  f'({product.stat().st_size:,} bytes)', flush=True)
        harness.cleanup()


def main(argv=None):
    args = parse_args(argv)
    try:
        build(args)
    except (BuildError, OSError, ValueError) as error:
        print(f'build_volkov: {error}', file=sys.stderr)
        return 1
    return 0


if __name__ == '__main__':
    raise SystemExit(main())
